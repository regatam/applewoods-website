# Lead form email (Resend). Free tier: https://resend.com
# Leave these unset to keep email delivery disabled while Slack remains available.
# If no delivery channel succeeds in Production, the endpoint returns 502. Accepted
# requests log metadata only, never contact details or message content.

# Resend API key (server-only secret — never prefix with VITE_)
RESEND_API_KEY=

# Sender address, must be on a Resend-verified domain, e.g. leads@applewoods.com
FROM_EMAIL=

# Production requires three unique inboxes: both client addresses plus Rene's
CLIENT_EMAILS=

# Auto-replies require this explicit opt-in and remain disabled until bilingual copy is approved
SEND_LEAD_AUTOREPLY=false

# Cloudflare Turnstile (the site key is intentionally public; the secret is not)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

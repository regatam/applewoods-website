# Lead form email (Resend). Free tier: https://resend.com
# Leave these unset and the contact form still works — the lead is logged in the
# Vercel function logs and no email is sent ("skipped" mode). Fill all three to
# turn on email notifications + the visitor auto-reply.

# Resend API key (server-only secret — never prefix with VITE_)
RESEND_API_KEY=

# Sender address, must be on a Resend-verified domain, e.g. leads@applewoods.com
FROM_EMAIL=

# Inbox that receives new lead notifications
CLIENT_EMAIL=
